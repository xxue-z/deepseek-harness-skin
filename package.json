{
  "name": "@xxue-z/dsh-skin",
  "version": "1.0.14",
  "private": true,
  "type": "module",
  "description": "Theme skin manager for DeepSeek Harness: Codex-Skins import, wallpaper skins, and an AI theme designer.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xxue-z/deepseek-harness-skin.git"
  },
  "homepage": "https://github.com/xxue-z/deepseek-harness-skin",
  "pkg": {
    "name": "@xxue-z/dsh-skin"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bundled-themes",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}