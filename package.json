{
  "name": "@local/dsh-skin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Theme skin manager for DeepSeek Harness: Codex-Skins import, wallpaper skins, and an AI theme designer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  }
}